{
  "name": "cetus-sui-ts-sdk",
  "private": true,
  "type": "module",
  "author": "Cetus",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docs": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:debug": "node --inspect-brk ./node_modules/.bin/vitest run",
    "prepare": "husky && node scripts/merge-workspace-paths.js",
    "publish_test:all": "node scripts/version.js all && for pkg in packages/*; do (cd $pkg && pnpm run publish_batch:test && sleep 1); done",
    "update-peer-deps": "node scripts/update-peer-deps.js"
  },
  "dependencies": {
    "@bluefin-exchange/bluefin7k-aggregator-sdk": "6.0.0",
    "@cetusprotocol/aggregator-sdk": "0.0.0-experimental-20260518183351",
    "@cetusprotocol/common-sdk": "1.3.1",
    "@mysten/sui": "2.16.3",
    "@pythnetwork/pyth-sui-js": "^2.2.0",
    "@sentry/nextjs": "^10.5.0",
    "@suchipi/femver": "^1.0.0",
    "@suilend/sdk": "^3.0.3",
    "@suilend/sui-fe": "^3.0.2",
    "@types/bn.js": "^5.1.1",
    "axios": "^1.4.0",
    "bignumber.js": "^9.3.1",
    "bn.js": "^5.2.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.1",
    "isomorphic-fetch": "^3.0.0",
    "js-base64": "^3.7.4",
    "js-sha3": "^0.8.0",
    "strip-ansi": "^7.1.0",
    "superstruct": "^1.0.3",
    "tiny-invariant": "^1.1.0",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "valibot": "0.36.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@types/cors": "^2.8.13",
    "@types/lossless-json": "^1.0.1",
    "@types/node": "^22.13.14",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "@vitest/coverage-v8": "^4.0.18",
    "bip39-light": "^1.0.7",
    "dotenv": "^16.4.7",
    "eslint": "^9.22.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "standard-version": "^9.5.0",
    "tslib": "^2.8.1",
    "tsup": "^8.4.0",
    "turbo": "^2.4.4",
    "typedoc": "^0.28.0",
    "typescript": "5.8.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "/": "pnpm run lint:fix"
  },
  "pnpm": {
    "overrides": {
      "@bluefin-exchange/bluefin7k-aggregator-sdk": "6.0.0",
      "@cetusprotocol/aggregator-sdk": "0.0.0-experimental-20260518183351",
      "chalk": "5.3.0",
      "strip-ansi": "7.1.0",
      "color-convert": "2.0.1",
      "color-name": "1.1.4",
      "is-core-module": "2.13.1",
      "error-ex": "1.3.2",
      "@bigmi/core": "^0.5.2",
      "@pythnetwork/pyth-sui-js>@mysten/sui": "1.45.2"
    }
  }
}
