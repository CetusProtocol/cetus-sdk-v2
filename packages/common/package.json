{
  "name": "@cetusprotocol/common-sdk",
  "version": "1.3.7",
  "description": "Common SDK for Cetus Protocol",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/*.ts src/**/*.ts",
    "test": "vitest run --include 'packages/common/**'",
    "build": "pnpm run build:tsup",
    "build:tsup": "npm run build:clean && npm run _build:node",
    "build:clean": "rm -rf dist",
    "_build:node": "tsup --format esm --dts",
    "build:doc": "npx typedoc",
    "publish_batch:test": "npm publish --tag experimental",
    "publish:test": "node ../../scripts/version.js common && npm publish --tag experimental"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "author": "Cetus",
  "license": "Apache-2.0",
  "dependencies": {
    "@pythnetwork/hermes-client": "^3.1.0"
  },
  "devDependencies": {
    "@mysten/sui": "2.16.3"
  },
  "peerDependencies": {
    "@mysten/sui": ">=2.0.0"
  }
}
